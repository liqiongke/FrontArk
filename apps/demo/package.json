{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode dev",
    "dev:prod": "vite --mode production",
    "dev:mock": "vite --mode mock",
    "build": "tsc -b && vite build --mode production",
    "build:dev": "tsc -b && vite build --mode dev",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:desktop:frontend": "cross-env VITE_APP_TARGET=desktop pnpm --dir ../.. exec turbo run dev:mock --filter=web --filter=mock-server",
    "build:desktop:frontend": "cross-env VITE_APP_TARGET=desktop pnpm run build",
    "test": "node --experimental-strip-types --test tests/*.test.mjs && vitest run",
    "test:ui": "vitest run"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@jl/framework": "workspace:*",
    "ahooks": "^3.9.6",
    "axios": "^1.13.2",
    "lodash": "^4.17.21",
    "lucide-react": "^1.48.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.64.0",
    "react-router-dom": "^7.9.6",
    "simplebar-react": "^3.3.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react-swc": "^4.2.1",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.2",
    "vite-plugin-pages": "^0.33.1",
    "vitest": "^5.0.0"
  }
}